    coltitle=white, fonttitle=\industrialfont\bfseries\small,
    before title={\textcolor{CupulaGold}{//}\hspace{0.4em}},
    before upper={\setlength{\parindent}{0pt}\setlength{\parskip}{0.4em plus 0.1em}\raggedright},
    colupper=CarbonDark,
  }
}

