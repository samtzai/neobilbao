% --- Titulares ----------------------------------------------------------
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{1ex}%
  {\parindent\z@ \raggedright \normalfont
   {\sffamily\bfseries\small\color{BurdinUrdin}\MakeUppercase{\chaptername}~\thechapter\par}%
   \vskip 4\p@
   {\sffamily\bfseries\LARGE\color{CarbonDark}#1\par}%
   \vskip 4\p@
   {\color{OrekakRust}\rule{\linewidth}{1.2pt}}%
   \vskip 14\p@}}
\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{1ex}%
  {\parindent\z@ \raggedright \normalfont
   {\sffamily\bfseries\LARGE\color{CarbonDark}#1\par}%
   \vskip 4\p@
   {\color{OrekakRust}\rule{\linewidth}{1.2pt}}%
   \vskip 14\p@}}

\renewcommand\section{\@startsection{section}{1}{\z@}%
  {2.2ex \@plus .5ex \@minus .2ex}{1ex \@plus .2ex}%
  {\sffamily\bfseries\large\color{OrekakRust}\raggedright}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {1.8ex \@plus .4ex \@minus .2ex}{.6ex \@plus .1ex}%
  {\sffamily\bfseries\normalsize\color{BurdinUrdin}\raggedright}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {1.4ex \@plus .3ex \@minus .2ex}{.4ex}%
  {\sffamily\bfseries\small\color{GoldDark}\raggedright}}

\def\@part[#1]#2{%
  \ifnum \c@secnumdepth >-2\relax
    \refstepcounter{part}%
    \addcontentsline{toc}{part}{\thepart\hspace{1em}#1}%
  \else
    \addcontentsline{toc}{part}{#1}%
  \fi
  {\parindent\z@ \centering \interlinepenalty\@M \normalfont
   \vspace*{\fill}%
   {\sffamily\bfseries\large\color{OrekakRust}\MakeUppercase{\partname}~\thepart\par}%
   \vskip 12\p@
   {\sffamily\bfseries\Huge\color{CarbonDark}#2\par}%
   \vspace*{\fill}\par}%
  \@endpart}
\makeatother

