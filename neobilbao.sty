% --- Cajas (sin tcolorbox): un lrbox con marco y barra de título --------
% Las cajas no se parten entre páginas; mantener su contenido corto.
\makeatletter
\newsavebox{\neo@box}
\newlength{\neo@rule}
\newcommand{\neo@boxbegin}[6]{% grosor, marco, fondo, texto, color barra, titulo
  \par\addvspace{\medskipamount}\noindent
  \setlength{\neo@rule}{#1}\def\neo@frame{#2}\def\neo@bg{#3}%
  \setlength{\fboxsep}{6pt}%
  \begin{lrbox}{\neo@box}%
  \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\neo@rule\relax}%
    \color{#4}\raggedright
    \setlength{\parindent}{0pt}\setlength{\parskip}{0.4em plus 0.1em}%
    \colorbox{#5}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
      \sffamily\bfseries\small\color{white}\MakeUppercase{#6}}}\par\vspace{0.2em}%
}
\newcommand{\neo@boxend}{%
  \end{minipage}\end{lrbox}%
  \setlength{\fboxrule}{\neo@rule}%
  \fcolorbox{\neo@frame}{\neo@bg}{\usebox{\neo@box}}%
  \par\addvspace{\medskipamount}}

\newenvironment{CajaSecreto}
  {\neo@boxbegin{2pt}{OrekakRust}{BoxRust}{CarbonDark}{OrekakRust}{Solo para ojos del Director}}
  {\neo@boxend}
\newenvironment{CajaCinematica}[1]
  {\neo@boxbegin{1pt}{BurdinUrdin}{CarbonDark}{SteelLight}{BurdinUrdin}{#1}}
  {\neo@boxend}
\newenvironment{FichaEnemigo}[1]
  {\neo@boxbegin{1pt}{CarbonDark}{BoxGray}{CarbonDark}{CarbonDark}{#1}}
  {\neo@boxend}
\newenvironment{FichaArquetipo}[1]
  {\neo@boxbegin{1pt}{GoldDark}{BoxGold}{CarbonDark}{GoldDark}{#1}}
  {\neo@boxend}
\newenvironment{CajaEjemplo}[1]
  {\neo@boxbegin{1pt}{AcidSirimiri}{BoxGreen}{CarbonDark}{AcidSirimiri}{#1}}
  {\neo@boxend}
\newenvironment{CajaRegla}[1]
  {\neo@boxbegin{1pt}{BurdinUrdin}{BoxBlue}{CarbonDark}{BurdinUrdin}{#1}}
  {\neo@boxend}
\makeatother

% Etiquetas dentro de las cajas oscuras del guion.
