\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neobilbao}[2026/10/12 NeoBilbao style package]

\RequirePackage[a5paper,margin=18mm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{hyperref}

\definecolor{BurdinBlue}{HTML}{0088B4}
\definecolor{OrekakRust}{HTML}{B84A1E}
\definecolor{CupulaGold}{HTML}{C49E35}
\definecolor{CarbonDark}{HTML}{20252B}
\definecolor{AcidGreen}{HTML}{4A7C2A}
\definecolor{SteelGray}{HTML}{C7CDD4}
\definecolor{WarningRed}{HTML}{C63E34}
\definecolor{Paper}{HTML}{F2E9DC}

\newcommand{\industrialfont}{\sffamily}
\newcommand{\capsfont}{\sffamily}

\hypersetup{
  colorlinks=true,
  linkcolor=BurdinBlue,
  urlcolor=BurdinBlue,
  citecolor=BurdinBlue
}

\pagecolor{CarbonDark}
\color{SteelGray}

\setlength{\parindent}{1.2em}
\setlength{\parskip}{0.45em}

\newcommand{\tag}[1]{\textcolor{AcidGreen}{\textbf{[#1]}}}
\newcommand{\alert}[1]{\textcolor{WarningRed}{\textbf{#1}}}
\newcommand{\key}[1]{\textcolor{BurdinBlue}{\textbf{#1}}}
\newcommand{\subtitle}[1]{\textcolor{CupulaGold}{\textbf{#1}}}

\newcommand{\NeoBox}[3]{%
\par\smallskip\noindent\fcolorbox{#1}{CarbonDark}{%
\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}
\vspace{0.35em}
\textcolor{#1}{\textbf{#2}}\par\smallskip\textcolor{SteelGray}{#3}
\vspace{0.25em}
\end{minipage}}
\par\smallskip
}

\newenvironment{CajaSecreto}{%
\par\smallskip\noindent\fcolorbox{WarningRed}{CarbonDark}{\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}\textcolor{WarningRed}{\textbf{SOLO PARA OJOS DEL DIRECTOR}}\par\smallskip}
}{%
\end{minipage}}
\par\smallskip
}

