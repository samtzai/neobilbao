\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neobilbao}[2026/10/12 Estilo NeoBilbao (XeLaTeX)]

\RequirePackage{iftex}
\RequireXeTeX

% --- Base ---------------------------------------------------------------
\RequirePackage{fontspec}
\RequirePackage{microtype}
\RequirePackage[a5paper,top=20mm,bottom=20mm,left=17mm,right=17mm,headheight=14pt]{geometry}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% --- Fuentes (TeX Gyre, incluidas en TeX Live) ---------------------------
\setmainfont{TeX Gyre Pagella}
\setsansfont{TeX Gyre Heros}
\newfontfamily\industrialfont{TeX Gyre Adventor}

% --- Paleta -------------------------------------------------------------
\definecolor{BurdinUrdin}{HTML}{0088B4}
\definecolor{OrekakRust}{HTML}{B84A1E}
\definecolor{CupulaGold}{HTML}{C49E35}
\definecolor{CarbonDark}{HTML}{20252B}
\definecolor{AcidSirimiri}{HTML}{4A7C2A}
\colorlet{GoldDark}{CupulaGold!70!black}
\colorlet{SteelLight}{CarbonDark!12!white}
\definecolor{BoxRust}{HTML}{F8E9E2}
\definecolor{BoxGold}{HTML}{F8F1DC}
\definecolor{BoxGreen}{HTML}{E8F0E2}
\definecolor{BoxBlue}{HTML}{E2F1F6}
\definecolor{BoxGray}{HTML}{ECEFF1}

\RequirePackage[hidelinks,unicode,pdfauthor={NeoBilbao Game Studio},pdftitle={NeoBilbao: Etxearen Zina}]{hyperref}

% --- Idioma (sin babel-spanish instalado) -------------------------------
\renewcommand{\contentsname}{Índice}
\renewcommand{\chaptername}{Capítulo}
\renewcommand{\partname}{Parte}
\renewcommand{\figurename}{Figura}

% Sin patrones de guionado español: se evita el guionado y se compone a bandera.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=3em

\color{CarbonDark}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em plus 0.2em minus 0.1em}
\raggedright
\setcounter{tocdepth}{1}

\setlist{leftmargin=1.4em,itemsep=2pt,topsep=3pt,parsep=0pt}

% --- Titulares ----------------------------------------------------------
\titleformat{\chapter}[display]
  {\raggedright\normalfont}
  {\industrialfont\bfseries\small\color{BurdinUrdin}\MakeUppercase{\chaptername}~\thechapter}
  {4pt}
  {\industrialfont\bfseries\LARGE\color{CarbonDark}}
  [\vspace{4pt}{\color{OrekakRust}\titlerule[1.2pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{16pt}

\titleformat{\section}{\industrialfont\bfseries\large\color{OrekakRust}\raggedright}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{2.2ex plus .5ex minus .2ex}{1ex plus .2ex}
\titleformat{\subsection}{\industrialfont\bfseries\normalsize\color{BurdinUrdin}\raggedright}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.8ex plus .4ex minus .2ex}{.6ex plus .1ex}
\titleformat{\subsubsection}{\industrialfont\bfseries\small\color{GoldDark}\raggedright}{\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus .3ex minus .2ex}{.4ex}

\makeatletter
\def\@part[#1]#2{%
  \ifnum \c@secnumdepth >-2\relax
    \refstepcounter{part}%
    \addcontentsline{toc}{part}{\thepart\hspace{1em}#1}%
  \else
    \addcontentsline{toc}{part}{#1}%
  \fi
  {\parindent\z@ \centering \interlinepenalty\@M \normalfont
   \vspace*{\fill}%
   {\industrialfont\bfseries\large\color{OrekakRust}\MakeUppercase{\partname}~\thepart\par}%
   \vskip 12\p@
   {\industrialfont\bfseries\Huge\color{CarbonDark}#2\par}%
   \vspace*{\fill}\par}%
  \@endpart}
\makeatother

% --- Cabeceras ----------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\fancyhead[L]{\industrialfont\scriptsize\color{BurdinUrdin}\MakeUppercase{\leftmark}}
\fancyhead[R]{\industrialfont\scriptsize\color{CarbonDark}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\color{BurdinUrdin}\hrule width\headwidth height\headrulewidth}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\industrialfont\scriptsize\thepage}%
  \renewcommand{\headrulewidth}{0pt}}

% --- Macros de texto ----------------------------------------------------
\newcommand{\tg}[1]{\textcolor{AcidSirimiri}{\textsf{\bfseries[#1]}}}
\newcommand{\lead}[1]{\textsf{\bfseries\textcolor{BurdinUrdin}{#1}}}
\newcommand{\dire}[1]{\textsf{\bfseries\textcolor{OrekakRust}{#1}}}
\newcommand{\cine}[1]{\textsf{\bfseries\textcolor{CupulaGold}{\MakeUppercase{#1}}}}

% --- Cajas tcolorbox ----------------------------------------------------
\tcbset{
  neo/.style={
    enhanced, breakable,
    arc=1.5mm, boxrule=1pt,
    left=6pt, right=6pt, top=4pt, bottom=4pt,
    before skip=8pt, after skip=8pt,
    coltitle=white, fonttitle=\industrialfont\bfseries\small,
    before upper={\setlength{\parindent}{0pt}\setlength{\parskip}{0.4em plus 0.1em}\raggedright},
    colupper=CarbonDark,
  }
}

\newtcolorbox{CajaSecreto}{neo,
  colframe=OrekakRust, colback=BoxRust, colbacktitle=OrekakRust,
  boxrule=2pt, title={\MakeUppercase{Solo para ojos del Director}}}

\newtcolorbox{CajaCinematica}[1]{neo,
  colframe=BurdinUrdin, colback=CarbonDark, colbacktitle=BurdinUrdin,
  colupper=SteelLight, title={\MakeUppercase{#1}}}

\newtcolorbox{FichaEnemigo}[1]{neo,
  colframe=CarbonDark, colback=BoxGray, colbacktitle=CarbonDark,
  title={\MakeUppercase{#1}}}

\newtcolorbox{FichaArquetipo}[1]{neo,
  colframe=GoldDark, colback=BoxGold, colbacktitle=GoldDark,
  title={\MakeUppercase{#1}}}

\newtcolorbox{CajaEjemplo}[1]{neo,
  colframe=AcidSirimiri, colback=BoxGreen, colbacktitle=AcidSirimiri,
  title={\MakeUppercase{#1}}}

\newtcolorbox{CajaRegla}[1]{neo,
  colframe=BurdinUrdin, colback=BoxBlue, colbacktitle=BurdinUrdin,
  title={\MakeUppercase{#1}}}

\endinput
